# 필요할 때 `.env`로 복사해 팀 기본 포트와 다른 값만 수정한다.
# Docker Compose와 `pnpm dev:api`가 같은 파일을 읽는다.
MONGODB_PORT=27017
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 로컬 MinIO 전용 자격증명. 운영 비밀값을 이 파일에 넣지 않는다.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# 웹 선택적 이용 분석. 로컬은 apps/web/.env.development.local, 운영은 Secret Manager의
# gole-production-env 새 버전에 넣는다. 미설정 시 완전 비활성이고, 둘 다 설정하면 GTM만
# 로드해 중복 페이지뷰를 막는다.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# 아래 값들은 필요할 때만 활성화한다.
# SERVER_PORT=8080
# MONGODB_URI=mongodb://localhost:27017/gole?replicaSet=rs0
# MONGODB_DATABASE=gole
# REDIS_HOST=localhost
# STORAGE_S3_ENDPOINT=http://localhost:9000

# --- 운영 배포(GOLE_ENVIRONMENT=production) ---
# local·staging 은 이 절을 건드릴 필요가 없다. production 또는 prod 로 두는 순간 기동
# 가드 두 개가 켜지고, 아래가 하나라도 어긋나면 앱이 예외를 던지며 아예 뜨지 않는다.
# 조용히 잘못 도는 쪽이 기동 실패보다 위험해서 일부러 부팅 단계에서 막는다.
#
# ProductionConfigurationGuard — 로컬 전용 동작과 샘플 데이터가 운영에 새는 것을 차단:
#   GOLE_VERIFICATION_EMAIL_ENABLED=false (Stage 0은 SMTP 없이 인증코드 기능을 503으로 차단)
#   GOLE_*_SEED 7개를 전부 false          (하나라도 true면 더미 데이터가 적재되므로 거부)
# 결제를 아직 열지 않는 초기 공개는 PORTONE_ENABLED=false와
# NEXT_PUBLIC_PAYMENT_MODE=disabled를 함께 사용한다. 공개 환경에서는 스텁 어댑터가 호출돼도
# 결제를 승인하지 않고 실패하므로, 실제 돈 없이 결제 완료처럼 보이는 상태가 생기지 않는다.
# PortOne을 true로 켤 때만 PaymentConfigurationGuard가 서버 비밀값과 채널 구성을 검증한다.
#
# 즉 초기 운영은 아래 시드 7개 + 시세 증빙 2개를 false로 두고 SMTP 송신도 비활성화한다.
# 기존 검증 계정 로그인은 유지하되 신규 이메일 가입·재발급·비밀번호 재설정·계정 삭제 인증은
# 고정된 503 응답으로 닫는다. OAuth는 이메일과 별도 readiness가 준비된 provider만 노출한다.
# GOLE_ENVIRONMENT=local
# GOLE_VERIFICATION_EMAIL_ENABLED=false
# GOLE_CATALOG_SEED=true
# GOLE_LISTING_SEED=true
# GOLE_PRICING_SEED=true
# 개발용 데모 체결·출처가 확인되지 않은 기존 체결을 시세 증빙에 포함할지 결정한다.
# production/staging에서는 둘 다 false가 아니면 서버가 기동을 거부한다.
# GOLE_PRICING_INCLUDE_DEMO=true
# GOLE_PRICING_INCLUDE_LEGACY=true
# GOLE_COMMUNITY_SEED=true
# GOLE_REPORT_SEED=true
# GOLE_REVIEW_SEED=true
# GOLE_MEDIA_SEED=true

# HTTPS 뒤에 두는 배포에서는 세션 쿠키에 Secure 를 강제한다. auto 는 요청 스킴을 따른다.
# GOLE_SESSION_COOKIE_SECURE=auto
# GOLE_TERMS_VERSION=2026-09-04
# GOLE_PRIVACY_VERSION=2026-09-05
# GOLE_THIRD_PARTY_PROVISION_VERSION=2026-09-04

# 액추에이터 노출 범위. 기본은 로드밸런서 헬스체크만 공개한다.
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
# GOLE_LOG_LEVEL=INFO

# --- 온보딩 전화 인증 ---
# 신규 매물과 새 listing 거래 연결은 이 별도 운영 래치가 true이고 대상 판매자의 실제
# 전화번호 인증 시각이 저장된 경우에만 열린다. 운영에서는 본인확인 절차와 기존 ACTIVE 매물
# preflight를 완료하기 전까지 반드시 false로 둔다. 누락 시 application.yml 기본값도 false다.
# GOLE_SELLER_IDENTITY_VERIFICATION_READY=false
#
# 로컬 기본은 기존 4단계 흐름을 검증하도록 true다. CoolSMS 채널·승인 템플릿이 아직 없는
# 초기 공개 운영에서는 반드시 false로 두면 상태 API가 이를 내려주고 웹이 전화 단계를
# 완전히 건너뛴다. production/staging에서 true로 켤 때는 COOLSMS_ENABLED=true와 승인된
# GOLE_ONBOARDING_PHONE_TEMPLATE_ID가 없으면 기동 가드가 서버를 띄우지 않는다.
# GOLE_ONBOARDING_PHONE_REQUIRED=true
# GOLE_ONBOARDING_PHONE_TEMPLATE_ID=
# GOLE_ONBOARDING_PHONE_CODE_VARIABLE=#{인증번호}
#
# OTP 원문 노출 스위치. 켜면 두 가지가 함께 열린다 — 로깅 어댑터가 코드를 마스킹 없이
# 남기고, Redis에도 해시 대신 평문으로 저장한다. 실제 알림톡이 없는 환경에서 전화 인증을
# 손으로 밟아보려면 이 값이 필요하다(로컬 프로필은 application-local.yml에서 이미 켜 둔다).
# staging/production에서는 true로 넣어도 PhoneVerificationCodeExposurePolicy가 환경을 함께
# 보고 무시하며, 발송 요청 자체도 fail-closed 된다.
# GOLE_ONBOARDING_LOG_VERIFICATION_CODES=false

# 정산 실행 방식. MANUAL | PROVIDER | DISABLED
# 기본 DISABLED — 신규 플랫폼 결제·정산을 닫고 Stage 1 당근형 직거래만 운영한다.
# MANUAL은 PG 계약·법률·세무·운영 절차를 확인한 뒤 명시적으로 선택한다.
# PROVIDER 는 PG 지급대행 어댑터(SettlementExecutionPort)가 있어야 하며, 없으면 부팅에 실패한다.
# DISABLED 는 기존 원장을 보존하되 어떤 지급도 시도하지 않는다.
# GOLE_SETTLEMENT_MODE=DISABLED
# 현재 도메인·C2C 모델·개인 판매자 지급을 PG/지급대행사가 서면 승인한 뒤에만 true.
# 단순히 PortOne 계정을 만들었거나 결제 테스트가 성공했다는 뜻이 아니다.
# GOLE_SETTLEMENT_PAYOUT_CONTRACT_VERIFIED=false
# 구매확정 후 실제 이체까지의 운영 완충 시간. 구매확정 뒤 분쟁 정책을 대신하지 않는다.
# GOLE_SETTLEMENT_PAYOUT_HOLDBACK=P3D
# GOLE_SETTLEMENT_PROVIDER_RETRY_AFTER=PT5M
# GOLE_SETTLEMENT_PROVIDER_CLAIM_TIMEOUT=PT10M
# GOLE_SETTLEMENT_PROVIDER_BATCH_SIZE=20
# GOLE_SETTLEMENT_PROVIDER_MAX_ATTEMPTS=5

# 플랫폼 수수료 정책. 배포 없이 요율을 바꿀 수 있게 환경변수로 뺀 값이다.
# MIN·MAX 가 0이면 하한·상한 없음.
# GOLE_FEE_RATE=0.05
# GOLE_FEE_MIN=0
# GOLE_FEE_MAX=0

# --- 관리자 계정 ---
# 둘 다 채우고 API를 재시작하면 ADMIN 계정이 생성된다(상태는 곧바로 VERIFIED — 이메일
# 인증 불필요). 비어 있으면 AdminAccountSeeder가 비활성이라 관리자 계정이 아예 없고
# /admin 의 API 호출이 401/403이 된다.
# 멱등하다 — 같은 이메일 계정이 이미 있으면 건너뛴다(기존 계정 승격이 아니다).
# GOLE_ADMIN_EMAIL=
# GOLE_ADMIN_PASSWORD=

# --- 소셜 로그인(OAuth) ---
# --- 단말 푸시 (FCM HTTP v1) ---
# 비우면 no-op 어댑터가 뜨고 서비스는 정상 동작한다. 결제 설정과 달리 기동을 막지 않는다 —
# 푸시가 닫혀도 인앱 알림은 그대로 남는다.
#
# 자격증명은 둘 중 하나. 파일 경로가 우선이고 더 안전하다(권한으로 막을 수 있다).
# BASE64 는 환경변수만 다루는 배포 볼트를 위한 경로다 — JSON 의 줄바꿈이 env 형식을 깨므로
# base64 로 감싼다. 이 키 하나면 앱 사용자 전원에게 푸시를 보낼 수 있으니 취급에 주의한다.
# FCM_ENABLED=true
# FCM_PROJECT_ID=gole-prod
# FCM_CREDENTIALS_PATH=/etc/gole/fcm-service-account.json
# FCM_CREDENTIALS_BASE64=

# provider 는 CLIENT_ID 가 비어 있으면 그것만 조용히 비활성된다 — 예외도 경고도 없다
# (OAuthProperties.configured()). 로그인 버튼을 눌러도 아무 반응이 없다면 대개 여기가
# 비어 있는 것이다. 쓰려는 provider 만 채우면 되고 나머지는 비워둬도 된다.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# KAKAO_OAUTH_CLIENT_ID=
# KAKAO_OAUTH_CLIENT_SECRET=
# NAVER_OAUTH_CLIENT_ID=
# NAVER_OAUTH_CLIENT_SECRET=
# 운영은 GCP Compose가 apex HTTPS 콜백 3개만 고정한다. 로컬 포트를 바꿀 때만 정확한
# 콜백 URI를 쉼표로 나열하며, 오리진만 적거나 query/fragment를 붙이면 부팅 또는 요청이 거부된다.
# GOLE_OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback/google,http://localhost:3000/auth/callback/kakao,http://localhost:3000/auth/callback/naver
#
# 인가·토큰·유저정보 엔드포인트와 scope 는 application.yml 기본값으로 충분하다.
# provider 가 URL을 바꾸거나 추가 동의항목이 필요할 때만
# {GOOGLE,KAKAO,NAVER}_OAUTH_{AUTH_URI,TOKEN_URI,USERINFO_URI,SCOPE} 로 덮는다.

# --- 메일(SMTP) · 이메일 인증 ---
# 기본값은 localhost:587 이고 거기에 SMTP 서버는 없다. 공개 환경에서
# GOLE_VERIFICATION_EMAIL_ENABLED=false이면 인증코드를 만들거나 로그로 대체 발송하지 않고
# 관련 API를 fail-closed 한다. local·dev·test·e2e만 명시적인 개발용 로그 전달을 허용한다.
# 운영 Stage 0은 false를 강제하며 SMTP_USERNAME·SMTP_PASSWORD·보낸사람 주소도 빈 값이어야 한다.
# SMTP를 나중에 열 때는 코드·운영 validator·Compose·CD를 함께 리뷰한 뒤 새 Secret version으로
# 전환한다. Secret에 자격증명만 먼저 넣어도 현재 정책은 배포를 거부한다.
#
# GOLE_MAIL_HEALTH_ENABLED 기본값은 이메일 인증 활성 여부를 따른다. spring.mail.host 가
# 정의되는 순간 Spring이 MailHealthIndicator 를 자동 등록하므로, 실제 SMTP를 켠 운영에서는
# 연결 장애가 전체 health에도 드러난다. 이메일 인증을 끈 로컬에서는 자동으로 비활성이다.
# Gmail SMTP를 쓰려면 Google 계정의 2단계 인증을 켜고 GoLe 전용 앱 비밀번호를 만든다.
# 일반 Google 비밀번호나 브라우저 인증코드를 저장하면 안 된다.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_STARTTLS_REQUIRED=true
# SMTP_SSL_CHECKSERVERIDENTITY=true
# GOLE_VERIFICATION_EMAIL_FROM=
# GOLE_MAIL_HEALTH_ENABLED=false

# --- 포트원(백엔드) ---
# 기본값(false)은 로컬·테스트에서만 스텁 결제다. staging·production에서는 호출 자체를
# 거부하며, 초기 공개는 Launch Stage 0~1과 프론트 disabled를 함께 사용한다.
#
# true 로 켜면 아래 네 값이 모두 있어야 앱이 뜬다. PaymentConfigurationGuard 가 순서대로
# 검사하고 하나라도 비면 기동을 거부한다:
#   API_SECRET → WEBHOOK_SECRET → STORE_ID → CHANNEL_KEY → CHANNEL_TYPE(TEST|LIVE)
# 반쯤 설정된 상태로 뜨면 서명 검증 없이 위조 웹훅을 받거나, 상점·채널 불일치로 모든
# 결제가 거부된다. 조용히 깨지는 쪽이라 기동 단계에서 막는다.
#
# 값 위치(포트원 콘솔 → 결제 연동 → 연동 정보):
#   API_SECRET, STORE_ID → `식별코드 · API Keys` 탭
#   CHANNEL_KEY          → `채널 관리` 탭 (카카오페이 채널)
#   CARD_CHANNEL_KEY     → `채널 관리` 탭 (KG이니시스 등 카드 채널)
#   WEBHOOK_SECRET       → `결제알림(Webhook) 관리` 탭
#
# 프론트도 함께 켜야 한다(apps/web/.env.example 참고). 백엔드만 켜면 브라우저가 결제창을
# 건너뛰는데 서버는 포트원 원장을 조회해 결제 건이 없으므로 주문이 결제 대기에 머문다.
# PORTONE_ENABLED=false
# PORTONE_API_SECRET=
# PORTONE_WEBHOOK_SECRET=
# PORTONE_STORE_ID=
# PORTONE_CHANNEL_KEY=
# PORTONE_CHANNEL_TYPE=TEST

# 카드 결제(선택). 비우면 카카오페이만 열린다.
#
# 서버는 채널 키로 결제수단을 정한다 — 카카오페이 채널의 카드 결제, 카드 채널의 간편결제는
# 모두 승인하지 않고 수동 검토로 보낸다. 그래서 두 키가 같으면 기동을 거부한다.
# CHANNEL_TYPE(TEST|LIVE)은 두 채널에 공통으로 적용된다.
#
# 프론트의 NEXT_PUBLIC_PORTONE_CARD_CHANNEL_KEY 와 같은 값이어야 한다. 다르면 결제창은
# 열리지만 서버 검증에서 전부 수동 검토로 떨어진다.
# PORTONE_CARD_CHANNEL_KEY=

# 결제 대기 재조정 주기. QA에서 빨리 보고 싶을 때만 줄이고 확인 후 원복한다.
# PORTONE_RECONCILIATION_MINIMUM_AGE=PT10M
# PORTONE_RECONCILIATION_INTERVAL=PT5M
# PORTONE_RECONCILIATION_INITIAL_DELAY=PT1M

# CoolSMS 알림톡(기본 비활성). 실제 자격증명은 로컬 .env 또는 배포 환경에만 둔다.
# COOLSMS_ENABLED=false
# COOLSMS_API_KEY=
# COOLSMS_API_SECRET=
# COOLSMS_PF_ID=

# 스모크 테스트용 변수 - notification/adapter/out/coolsms/CoolsmsAlimtalkIntegrationTest.java
# COOLSMS_TEST_TO=
# COOLSMS_TEST_TEMPLATE_ID=
# COOLSMS_TEST_VARIABLES_JSON={"#{~~~}":"~~~~"}
# COOLSMS_SMOKE_TEST_ENABLED=true

# --- Discord 운영 관제 알림 ---
# 기본은 꺼져 있다. 운영에서는 CD 워크플로가 GitHub Secrets 로 주입하므로 웹훅 URL을 이
# 파일이나 저장소에 넣지 않는다 — 로컬에서 알림 형태를 확인할 때만 채운다.
#
# 켜면 역할별 웹훅 네 개(ACCOUNT·PAYMENT·SUPPORT·OPERATIONS)가 전부 있어야 앱이 뜬다.
# DiscordConfigurationGuard 가 하나라도 비면 기동을 거부하며, DISCORD_WEBHOOK_URL 로
# 폴백하지 않는다 — 모든 사건이 한 채널로 몰려 라우팅 실수가 묻히는 것을 막는 의도다.
# GOLE_DISCORD_ALERTS_ENABLED=false
# DISCORD_ACCOUNT_WEBHOOK_URL=
# DISCORD_PAYMENT_WEBHOOK_URL=
# DISCORD_SUPPORT_WEBHOOK_URL=
# DISCORD_OPERATIONS_WEBHOOK_URL=
#
# 야간·초기 연동 중에는 메시지는 보내되 푸시 알림은 울리지 않게 한다.
# DISCORD_SUPPRESS_NOTIFICATIONS=true
# DISCORD_AVATAR_URL=https://gole.co.kr/icon.svg
# 같은 애플리케이션/인프라 장애를 이 시간 동안 한 건으로 묶는다(ISO-8601 Duration).
# DISCORD_DEDUPLICATION_WINDOW=PT5M

# --- 문의 AI 보조(LangGraph · gRPC) ---
# 기본 OFF. 켜더라도 자동 답변/자동 종결은 하지 않고 관리자용 분류·초안만 만든다.
# 현재 rules-v1은 외부 모델을 호출하지 않으며 문의 원문을 로그·Discord에 남기지 않는다.
# GOLE_SUPPORT_AGENT_ENABLED=false
# GOLE_SUPPORT_AGENT_GRPC_TARGET=localhost:50051
# GOLE_SUPPORT_AGENT_TIMEOUT=PT2S

# --- 스토리지(S3 · MinIO) ---
# 로컬 기본값은 docker-compose 의 MinIO(minioadmin/minioadmin)를 그대로 쓴다.
# 운영에서는 ACCESS_KEY·SECRET_KEY 를 반드시 덮어쓴다. 안 덮으면 기본 자격증명 그대로
# 열린 스토리지가 된다.
#
# STORAGE_PUBLIC_BASE_URL 의 기본값은 이미 운영 도메인이다. 로컬·스테이징에서 덮어쓰지
# 않으면 방금 업로드한 이미지의 URL 이 운영을 가리켜 404 로 보인다.
# STORAGE_S3_ACCESS_KEY=minioadmin
# STORAGE_S3_SECRET_KEY=minioadmin
# STORAGE_S3_BUCKET=gole
# STORAGE_S3_REGION=us-east-1
# STORAGE_PUBLIC_BASE_URL=http://localhost:8080
#
# 업로드 크기 상한(바이트). 이미지 5MB, 요청 전체 55MB.
# STORAGE_MAX_IMAGE_BYTES=5242880
# JPEG/PNG 디코드 상한. GIF/WebP/APNG 업로드는 애니메이션 여부와 무관하게 거부한다.
# STORAGE_MAX_IMAGE_WIDTH=8192
# STORAGE_MAX_IMAGE_HEIGHT=8192
# STORAGE_MAX_IMAGE_PIXELS=16000000
# STORAGE_MAX_REQUEST_BYTES=55000000

# --- 배송 트래커(Delivery Tracker · tracker.delivery) ---
# 기본은 스텁 — 등록 경과 시간으로 상태를 시뮬레이션한다(1분 후 이동중, 3분 후 배송완료).
# 실 연동은 https://tracker.delivery 에서 클라이언트를 만들어 ID/시크릿을 받아 셋 다 채운다.
# 자격증명이 없어도 앱은 정상 부팅한다(스텁 폴백). 켰는데 ID/시크릿이 비면 조회가 전부
# UNKNOWN 으로 접혀 24시간 뒤 예외 큐에 올라온다.
# SHIPPING_TRACKER_ENABLED=false
# SHIPPING_TRACKER_CLIENT_ID=
# SHIPPING_TRACKER_CLIENT_SECRET=
# SHIPPING_TRACKER_API_BASE=https://apis.tracker.delivery/graphql
#
# 폴링·캐시 주기. 실 API 는 호출량 과금이 있을 수 있으니 운영에서 함부로 줄이지 않는다.
# SHIPPING_TRACKER_POLL_INTERVAL=PT1M
# SHIPPING_TRACKER_CACHE_TTL_ACTIVE=PT10M
# SHIPPING_TRACKER_CACHE_TTL_DELIVERED=PT24H
# 스텁 시뮬레이션 속도(로컬 데모용). 줄이면 전 구간을 몇 분 안에 볼 수 있다.
# SHIPPING_TRACKER_STUB_IN_TRANSIT_AFTER=PT1M
# SHIPPING_TRACKER_STUB_DELIVERED_AFTER=PT3M

# --- 주문 파이프라인 타임아웃(R9 — 무개입 원칙) ---
# 정상 거래는 운영자 개입 0 으로 끝까지 흘러간다. 모든 상태는 타임아웃과 기본 처리를 가진다.
# 값은 ISO-8601 기간(PT30M=30분, P3D=3일). 코드에 상수가 없으므로 여기서만 바꾼다.
# GOLE_PIPELINE_INTERVAL=PT1M
# GOLE_PIPELINE_PAYMENT_EXPIRY=PT30M        # 미결제 → 실패 처리 + 매물 예약 해제(스텁 결제 모드 전용)
# GOLE_PIPELINE_SHIPMENT_REMINDER=P3D       # 운송장 미등록 → 판매자 독촉 알림
# GOLE_PIPELINE_UNSHIPPED_REFUND=P7D        # 운송장 미등록 → 자동 전액 환불 + 매물 복구
# GOLE_PIPELINE_CARRIER_PICKUP_TIMEOUT=P3D  # 택배사 미접수 → 예외 큐
# GOLE_PIPELINE_TRANSIT_STALL=P14D          # 배송 정체 → 예외 큐
# GOLE_PIPELINE_AUTO_COMPLETE=P7D           # 배송완료 + 무분쟁 → 자동 구매확정 + 정산
# GOLE_PIPELINE_DISPUTE_ESCALATION=P3D      # 분쟁 미판정 → 에스컬레이션(자동 판정 없음)
# GOLE_PIPELINE_TRACKER_UNKNOWN=PT24H       # 추적 불가 지속 → 예외 큐
